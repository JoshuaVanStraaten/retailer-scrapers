# Savvy Grocery Scraper - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_BUCKET=product_images

# =============================================================================
# OPTIONAL - Discord Notifications
# =============================================================================
# Get webhook URL from: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_NOTIFICATIONS_ENABLED=true

# =============================================================================
# OPTIONAL - Scraper Settings
# =============================================================================
# Threading - reduce if running on limited resources (e.g., GitHub Actions)
MAX_THREADS=4

# Request timing (in seconds)
REQUEST_TIMEOUT=30
PAGE_DELAY=2.0
RETRY_DELAY_BASE=2.0
MAX_RETRIES=3

# Image handling
# Set to true to delete local images after uploading to Supabase
DELETE_LOCAL_IMAGES=true
# Set to true to use retailer CDN URLs directly (may have CORS issues)
USE_CDN_URLS=false

# Batch size for Supabase upserts
SUPABASE_BATCH_SIZE=500

# =============================================================================
# OPTIONAL - Directory Paths
# =============================================================================
DATA_DIR=./data
LOG_DIR=./logs
IMAGE_DIR=./images

# =============================================================================
# OPTIONAL - Playwright (Browser Automation)
# =============================================================================
# Set to false for debugging (shows browser window)
PLAYWRIGHT_HEADLESS=true
# Slow down actions by X milliseconds (useful for debugging)
PLAYWRIGHT_SLOW_MO=0
# Default timeout in milliseconds
PLAYWRIGHT_TIMEOUT=30000
